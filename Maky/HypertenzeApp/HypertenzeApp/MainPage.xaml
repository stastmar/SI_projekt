<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HypertenzeApp.MainPage" Title="Hypertenze">
    <ScrollView BackgroundColor="#F4F7FB">
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Moje zdraví" FontSize="30" FontAttributes="Bold" TextColor="#17365D" />
            <Label Text="Záznam krevního tlaku" FontSize="16" TextColor="#52657A" />
            <Border BackgroundColor="White" Stroke="#DDE5EE" StrokeThickness="1" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nové měření" FontSize="21" FontAttributes="Bold" TextColor="#17365D" />
                    <Label Text="Systolický tlak (mmHg)" />
                    <Entry x:Name="SystolicEntry" Placeholder="např. 125" Keyboard="Numeric" />
                    <Label Text="Diastolický tlak (mmHg)" />
                    <Entry x:Name="DiastolicEntry" Placeholder="např. 80" Keyboard="Numeric" />
                    <Label Text="Puls (tepů/min)" />
                    <Entry x:Name="PulseEntry" Placeholder="např. 72" Keyboard="Numeric" />
                    <Button Text="Uložit měření" Clicked="OnSaveClicked" BackgroundColor="#1769AA" TextColor="White" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Poslední měření" FontSize="21" FontAttributes="Bold" TextColor="#17365D" />
            <Label x:Name="LatestLabel" Text="Zatím žádné měření" FontSize="16" />
            <Label Text="Historie měření" FontSize="21" FontAttributes="Bold" TextColor="#17365D" />
            <VerticalStackLayout x:Name="HistoryContainer" Spacing="8" />
            <Label Text="Prototyp: data se ukládají lokálně v telefonu. Napojení na API bude doplněno po odsouhlasení rozhraní." FontSize="12" TextColor="#52657A" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
