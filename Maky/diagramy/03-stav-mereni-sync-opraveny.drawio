oints"><mxPoint x="1340" y="722" /><mxPoint x="1340" y="472" /></Array></mxGeometry></mxCell><mxCell id="e12" value="409: stejné ID, jiný obsah" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=13;fontColor=#17365D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.3;" edge="1" parent="1" source="sending" target="conflict"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="640" /><mxPoint x="955" y="890" /></Array></mxGeometry></mxCell><mxCell id="e13" value="Timeout / 5xx / offline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=13;fontColor=#17365D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=1;entryY=0.3;" edge="1" parent="1" source="sending" target="retry"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="525" y="640" /><mxPoint x="525" y="890" /></Array></mxGeometry></mxCell><mxCell id="e14" value="Opakovat po obnovení spojení" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=13;fontColor=#17365D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="retry" target="offline"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="900" /><mxPoint x="40" y="472" /></Array></mxGeometry></mxCell><mxCell id="note" value="Konflikt 409: záznam se nesmí automaticky přepsat. Je nutné prověřit rozdílný obsah a zachovat historii. Přesný postup vyřešení konfliktu je nutné sjednotit s návrhem API." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#E6A23C;fontColor=#6B4E16;fontSize=14;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="930" y="980" width="530" height="110" as="geometry" /></mxCell><mxCell id="description" value="Popis: Aplikace ověří zadané měření a uloží je do lokální offline fronty. Jakmile je dostupná síť a platné přihlášení, odešle záznam na WEB API. Odpovědi 200/201 znamenají úspěch; chyby 400/422, 401, 409 a dočasné výpadky mají odlišné následné stavy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F8FF;strokeColor=#CBD5E1;fontColor=#17365D;fontSize=15;align=left;spacing=15;" vertex="1" parent="1"><mxGeometry x="150" y="1140" width="1300" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>