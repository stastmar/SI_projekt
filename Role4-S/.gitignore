# =========================================================
#  .gitignore – SI2 projekt (telemedicínský systém)
# =========================================================

# ---------- Systémové soubory ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ---------- Microsoft Office ----------
# dočasné/zámkové soubory při otevřeném dokumentu
~$*
*.tmp
# automatické zálohy Wordu
*.asd
*.wbk

# ---------- LibreOffice ----------
.~lock.*#

# ---------- Diagramy ----------
# draw.io / diagrams.net – zálohy a dočasné soubory
*.bkp
*.drawio.bkp
.$*.drawio
.$*.dtmp
*.drawio.dtmp

# PlantUML – vygenerované obrázky ve složce out/ (zdroj je .puml)
out/

# Enterprise Architect – zámkové soubory
*.ldb
*.qeax.lck

# Visual Paradigm
*.vpp.bak*
*.vpp.lck
*.vux

# StarUML / Astah – zálohy
*.mdj.bak
*.asta.bak
*.bak

# ---------- Editory a IDE ----------
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ---------- Citlivé údaje (nikdy necommitovat) ----------
.env
.env.*
*.pem
*.key
secrets/

# ---------- Archivy a velké soubory ----------
*.zip
*.rar
*.7z
*.tar.gz

# ---------- Logy a dočasné složky ----------
*.log
tmp/
temp/

# ---------- Případný kód (prototyp, LaTeX) ----------
# Node.js
node_modules/
dist/
build/
# Python
__pycache__/
*.pyc
.venv/
venv/
# LaTeX (pokud byste psali dokument v LaTeXu / Overleafu)
*.aux
*.toc
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
