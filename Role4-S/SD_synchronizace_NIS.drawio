<mxfile host="app.diagrams.net"><diagram id="sd-nis" name="Stavový diagram – synchronizace s NIS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Stavový diagram – synchronizace s NIS (integrátor)" style="text;html=1;fontStyle=1;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="700" height="30" as="geometry"/></mxCell><mxCell id="init" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="160" y="70" width="30" height="30" as="geometry"/></mxCell><mxCell id="fin" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="30" height="30" as="geometry"/></mxCell><mxCell id="idle" value="Nečinný&lt;hr&gt;čeká na další periodu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="230" height="74" as="geometry"/></mxCell><mxCell id="load" value="Načítání dat z DB&lt;hr&gt;do / vybrat měření se stavem&lt;br&gt;&lt;i&gt;čeká&lt;/i&gt; (nová i opravená)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="230" height="84" as="geometry"/></mxCell><mxCell id="conv" value="Převod na FHIR&lt;hr&gt;do / Patient, Observation&lt;br&gt;(krevní tlak, puls – LOINC)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="190" width="230" height="84" as="geometry"/></mxCell><mxCell id="send" value="Odesílání do NIS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="190" width="230" height="74" as="geometry"/></mxCell><mxCell id="save" value="Ukládání výsledku&lt;hr&gt;do / NisSynchronizace:&lt;br&gt;stav, fhir_resource_id, čas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="230" height="84" as="geometry"/></mxCell><mxCell id="err" value="Chyba spojení&lt;hr&gt;entry / pokusy + 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="470" width="230" height="74" as="geometry"/></mxCell><mxCell id="wait" value="Čekání na opakování&lt;hr&gt;interval 1 → 5 → 15 min" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="320" width="230" height="74" as="geometry"/></mxCell><mxCell id="down" value="NIS dlouhodobě nedostupný&lt;hr&gt;entry / e-mail administrátorovi&lt;br&gt;(jen jednou)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="740" width="230" height="84" as="geometry"/></mxCell><mxCell id="t0" value="spuštění služby" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="init" target="idle"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t1" value="after(perioda)&lt;br&gt;/ ruční spuštění" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="idle" target="load"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t2" value="[žádná nová data]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="load" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="135"/><mxPoint x="250" y="135"/></Array></mxGeometry></mxCell><mxCell id="t3" value="[nalezena data]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="load" target="conv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t4" value="" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="conv" target="send"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t5" value="2xx / stav = odesláno&lt;br&gt;4xx (odmítnuto) / stav = chyba" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="send" target="save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t6" value="[další záznam]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="save" target="conv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t7" value="[vše zpracováno]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="save" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="512"/></Array></mxGeometry></mxCell><mxCell id="t8" value="timeout / 5xx / bez spojení" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="send" target="err"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t9" value="[pokusy &amp;lt; 5]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="err" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t10" value="after(interval)" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="wait" target="send"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t11" value="[pokusy ≥ 5 nebo výpadek &amp;gt; 1 h]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="err" target="down"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t12" value="after(perioda) / nový pokus;&lt;br&gt;při úspěchu e-mail o obnovení" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="down" target="send"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1830" y="782"/><mxPoint x="1830" y="227"/></Array></mxGeometry></mxCell><mxCell id="t13" value="administrátor zastaví službu" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="idle" target="fin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Parametry (nastavuje administrátor)&lt;/b&gt;&lt;br&gt;• perioda synchronizace: 15 min&lt;br&gt;• max. 5 pokusů s rostoucím intervalem 1, 5, 15 min&lt;br&gt;• dlouhodobý výpadek: &amp;gt; 1 h → e-mail administrátorovi&lt;br&gt;• integrátor čte DB napřímo (bez WEB API) přes účet s minimálními oprávněními&lt;br&gt;• stav záznamu v NisSynchronizace: čeká → odesláno / chyba" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="470" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>