chronizace)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#FFF7E6;strokeColor=#B45309;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="815" y="610" width="280" height="80" as="geometry"/></mxCell><mxCell id="f0" value="F1: tlak a puls z tlakoměru (Bluetooth),&lt;br&gt;záznam soli a energetických nápojů" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pac" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1" value="F2: měření, aktivita, životospráva&lt;br&gt;JSON přes HTTPS + přístupový token" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="app" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="F3: potvrzení uložení, historie,&lt;br&gt;doporučení lékaře – JSON přes HTTPS" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="api" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="F4: přihlášení (heslo + 2FA), limity,&lt;br&gt;řešení alertu, doporučení – HTTPS" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0.8;exitY=0;entryX=0;entryY=0.35;" edge="1" parent="1" source="lek" target="por"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="F5: seznam pacientů, grafy, alerty – HTTPS&lt;br&gt;(urgentní alert i e-mailem)" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0.15;exitY=0.85;entryX=1;entryY=0.6;" edge="1" parent="1" source="por" target="lek"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="F6: požadavky&lt;br&gt;REST + token" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0.15;exitY=0.15;entryX=0.2;entryY=0.9;" edge="1" parent="1" source="por" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" value="F7: data&lt;br&gt;(JSON)" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0.8;exitY=0.9;entryX=0.85;entryY=0.15;" edge="1" parent="1" source="api" target="por"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f7" value="F8: zápis a čtení dat&lt;br&gt;SQL přes TLS" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0.95;exitY=0.7;entryX=0.15;entryY=0;startArrow=block;startFill=1;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f8" value="F9: nová a opravená&lt;br&gt;měření – SQL (jen čtení)" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0.95;exitY=0;entryX=0.95;entryY=0.7;" edge="1" parent="1" source="db" target="int"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f9" value="F10: stav&lt;br&gt;synchronizace – SQL" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0.05;exitY=0.7;entryX=0.4;entryY=0;" edge="1" parent="1" source="int" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f10" value="F11: Patient, Observation&lt;br&gt;HL7 FHIR přes HTTPS (VPN)" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=1;exitY=0.35;entryX=0;entryY=0.3;" edge="1" parent="1" source="int" target="nis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f11" value="F12: potvrzení / odmítnutí&lt;br&gt;FHIR odpověď" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0;exitY=0.75;entryX=1;entryY=0.7;" edge="1" parent="1" source="nis" target="int"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;▭ externí entita &amp;nbsp; ◯ proces &amp;nbsp; ═ úložiště dat&lt;br&gt;→ tok dat (co / jak) &amp;nbsp; &lt;font color='#DC2626'&gt;┅┅&lt;/font&gt; hranice důvěry" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="1230" y="660" width="270" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>