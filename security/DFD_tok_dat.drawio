<mxfile host="app.diagrams.net"><diagram id="dfd" name="DFD – tok dat"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Diagram toku dat (DFD) – telemedicínský systém (hypertenze)" style="text;html=1;fontStyle=1;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="z_phone" value="Hranice důvěry 1: zařízení pacienta&lt;br&gt;(mimo naši kontrolu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#DC2626;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#B91C1C;fontStyle=1;fontSize=11;arcSize=4;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="20" y="265" width="290" height="265" as="geometry"/></mxCell><mxCell id="z_srv" value="Hranice důvěry 2: server systému (důvěryhodná zóna)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#DC2626;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#B91C1C;fontStyle=1;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="370" y="50" width="790" height="800" as="geometry"/></mxCell><mxCell id="z_db" value="Hranice důvěry 3: databázová zóna (jen vnitřní síť)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#DC2626;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#B91C1C;fontStyle=1;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="780" y="555" width="350" height="195" as="geometry"/></mxCell><mxCell id="z_nis" value="Hranice důvěry 4: nemocnice (externí systém)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#DC2626;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=